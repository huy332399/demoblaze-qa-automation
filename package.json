{
  "name": "demoblaze-playwright-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade QA Automation Framework for DemoBlaze using Playwright and TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:perf": "playwright test tests/performance",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "generate:docs": "node --experimental-strip-types docs/generate-test-cases.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "qa",
    "e2e",
    "demoblaze",
    "pom",
    "ci-cd"
  ],
  "author": "QA Automation Engineer",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
